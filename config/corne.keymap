#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "zmk-helpers/helper.h"
#include <locale/keys_de.h>

/* Layer numbers follow declaration order. */
#define LAYER_AEROSPACE   1
#define LAYER_PROGRAMMING 2
#define LAYER_NAVIGATION  3
#define LAYER_CONTROL     4

/* Standard macOS German input source, ISO keyboard type.
 * Option combinations differ from the generic German locale header.
 */
#define MAC_AT          RA(DE_L)
#define MAC_LBKT        RA(N5)
#define MAC_RBKT        RA(N6)
#define MAC_LBRC        RA(N8)
#define MAC_RBRC        RA(N9)
#define MAC_BACKSLASH   RA(LS(N7))
#define MAC_PIPE        RA(N7)
#define MAC_TILDE       RA(DE_N)
#define MAC_BULLET      RA(DE_U_UMLAUT)
#define MAC_EN_DASH     RA(DE_MINUS)
#define MAC_EM_DASH     LS(RA(DE_MINUS))
#define MAC_ELLIPSIS    RA(DE_DOT)
#define MAC_INV_EXCL    RA(N1)
#define MAC_INV_QUEST   RA(DE_SZ)

/* Native replacements: Shift+ß -> ¿, programming ſ -> §, navigation − -> —.
 * Shift-only punctuation masks Shift before sending the Option combination.
 */
ZMK_MOD_MORPH(sz_shift,
    bindings = <&kp DE_SZ>, <&kp MAC_INV_QUEST>;
    mods = <(MOD_LSFT | MOD_RSFT)>;
)

ZMK_MOD_MORPH(comma_shift,
    bindings = <&kp DE_COMMA>, <&kp MAC_EN_DASH>;
    mods = <(MOD_LSFT | MOD_RSFT)>;
)

ZMK_MOD_MORPH(dot_shift,
    bindings = <&kp DE_DOT>, <&kp MAC_BULLET>;
    mods = <(MOD_LSFT | MOD_RSFT)>;
)

/* Preserve ordinary punctuation in shortcuts, including Cmd+Shift+period.
 * These outer morphs bypass the Shift morph when Cmd or Ctrl is held.
 */
#define SHORTCUT_MODS (MOD_LGUI | MOD_RGUI | MOD_LCTL | MOD_RCTL)

ZMK_MOD_MORPH(comma_key,
    bindings = <&comma_shift>, <&kp DE_COMMA>;
    mods = <SHORTCUT_MODS>;
    keep-mods = <SHORTCUT_MODS>;
)

ZMK_MOD_MORPH(dot_key,
    bindings = <&dot_shift>, <&kp DE_DOT>;
    mods = <SHORTCUT_MODS>;
    keep-mods = <SHORTCUT_MODS>;
)

/* Finish dead keys with Space so programming symbols are emitted immediately.
 * Use these with Shift/Option released; additional held modifiers affect them.
 */
ZMK_MACRO(literal_caret,
    wait-ms = <10>;
    tap-ms = <10>;
    bindings = <&macro_tap &kp DE_CARET &kp SPACE>;
)

ZMK_MACRO(literal_tilde,
    wait-ms = <10>;
    tap-ms = <10>;
    bindings = <&macro_tap &kp MAC_TILDE &kp SPACE>;
)

ZMK_MACRO(literal_grave,
    wait-ms = <10>;
    tap-ms = <10>;
    bindings = <&macro_tap &kp DE_GRAVE &kp SPACE>;
)

/* Thumb hold-tap: tap = key, hold = modifier.
 * A non-modifier key pressed within the preceding 125 ms forces a tap.
 * Remove require-prior-idle if intentional Ctrl/Alt holds become Tab/Return.
 * Usage: &thm MODIFIER KEY  (e.g. &thm LCTRL TAB) */
ZMK_HOLD_TAP(thm,
    flavor = "balanced";
    tapping-term-ms = <200>;
    require-prior-idle-ms = <125>;
    bindings = <&kp>, <&kp>;
)

/* Tri-layer: holding M3 (layer 2) + M4 (layer 3) activates control layer (4) */
/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LAYER_PROGRAMMING LAYER_NAVIGATION>;
            then-layer = <LAYER_CONTROL>;
        };
    };
};

/* ─── Layer 0 — Default ─────────────────────────────────────────────────────
   J    Z    Y    U    A    Q  │  P    B    M    L    F    ß
   M3   C    S    I    E    O  │  D    T    N    R    H    M3
  Cmd   V    X    Ü    Ä    Ö  │  W    G    ,    .    K   Cmd
              M4  Sft  Ctl/Tab │ Alt/Ret  Spc  AS
─────────────────────────────────────────────────────────────────────────── */
ZMK_LAYER(default_layer,
  &kp DE_J               &kp DE_Z  &kp DE_Y  &kp DE_U              &kp DE_A         &kp DE_Q           &kp DE_P       &kp DE_B   &kp DE_M             &kp DE_L  &kp DE_F  &sz_shift
  &mo LAYER_PROGRAMMING  &kp DE_C  &kp DE_S  &kp DE_I              &kp DE_E         &kp DE_O           &kp DE_D       &kp DE_T   &kp DE_N             &kp DE_R  &kp DE_H  &mo LAYER_PROGRAMMING
  &kp LMETA              &kp DE_V  &kp DE_X  &kp DE_U_UMLAUT       &kp DE_A_UMLAUT  &kp DE_O_UMLAUT    &kp DE_W       &kp DE_G   &comma_key           &dot_key  &kp DE_K  &kp RMETA
                                             &mo LAYER_NAVIGATION  &kp LSHIFT       &thm LCTRL TAB     &thm LALT RET  &kp SPACE  &mo LAYER_AEROSPACE
)

/* ─── Layer 1 — AeroSpace (right outer thumb) ──────────────────────────────
   --   --   --   --   --   --  │  --    7    8    9   --   --
   --   --   --   --   --   --  │  --    4    5    6   --   --
   --   --   --   --   --   --  │  --    1    2    3   --   --
                     --  Shift  --  │  --   --   --
─────────────────────────────────────────────────────────────────────────── */
/* Each number sends Cmd+Ctrl+number. Hold Shift to move the focused window.
 * No transparent keys: the layer cannot leak text or activate another layer.
 */
ZMK_LAYER(aerospace_layer,
  &none  &none  &none  &none  &none       &none    &none  &kp LG(LC(N7))  &kp LG(LC(N8))  &kp LG(LC(N9))  &none  &none
  &none  &none  &none  &none  &none       &none    &none  &kp LG(LC(N4))  &kp LG(LC(N5))  &kp LG(LC(N6))  &none  &none
  &none  &none  &none  &none  &none       &none    &none  &kp LG(LC(N1))  &kp LG(LC(N2))  &kp LG(LC(N3))  &none  &none
                       &none  &kp LSHIFT  &none    &none  &none           &none
)

/* M3/M4 are programming/navigation; AS is AeroSpace.
 * AS is accessible from the base layer; higher layers block its thumb key.
 * M3/M4 labels indicate physical layer keys;
 * their own-layer bindings are blocked below.
 */

/* ─── Layer 2 — Programming (M3) ────────────────────────────────────────────
   @    …    _    [    ]    ^  │  !    <    >    =    &    §
   M3   \    /    {    }    *  │  ?    (    )    -    :    M3
  Cmd   #    $    |    ~    `  │  +    %    "    '    ;   Cmd
              M4  Sft Ctl/Tab  │ Alt/Ret  Spc  --
─────────────────────────────────────────────────────────────────────────── */
ZMK_LAYER(programming_layer,
  &kp MAC_AT  &kp MAC_ELLIPSIS   &kp DE_UNDERSCORE  &kp MAC_LBKT          &kp MAC_RBKT    &literal_caret    &kp DE_EXCLAMATION  &kp DE_LT     &kp DE_GT    &kp DE_EQUAL  &kp DE_AMPS   &kp DE_SECTION
  &none       &kp MAC_BACKSLASH  &kp DE_FSLH        &kp MAC_LBRC          &kp MAC_RBRC    &kp DE_STAR       &kp DE_QMARK        &kp DE_LPAR   &kp DE_RPAR  &kp DE_MINUS  &kp DE_COLON  &none
  &kp LMETA   &kp DE_HASH        &kp DE_DLLR        &kp MAC_PIPE          &literal_tilde  &literal_grave    &kp DE_PLUS         &kp DE_PRCNT  &kp DE_DQT   &kp DE_SQT    &kp DE_SEMI   &kp RMETA
                                                    &mo LAYER_NAVIGATION  &trans          &thm LCTRL TAB    &thm LALT RET       &kp SPACE     &none
)

/* ─── Layer 3 — Util / Nav+Num (M4) ─────────────────────────────────────────
   —   PgUp   ⌫    ↑    ⌦   PgDn │  ¡    7    8    9    +    ;
   M3  Home   ←    ↓    →   End  │  ¿    4    5    6    .    M3
  Cmd  Esc   Tab  Pst  Ret  Undo │  :    1    2    3    ,   Cmd
              M4  Sft Ctl/Tab    │ Alt/Ret   0   --
─────────────────────────────────────────────────────────────────────────── */
ZMK_LAYER(util_layer,
  &kp MAC_EM_DASH        &kp PAGE_UP  &kp BACKSPACE   &kp UP_ARROW    &kp DELETE       &kp PAGE_DOWN     &kp MAC_INV_EXCL   &kp N7  &kp N8  &kp N9  &kp DE_PLUS   &kp DE_SEMI
  &mo LAYER_PROGRAMMING  &kp HOME     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END           &kp MAC_INV_QUEST  &kp N4  &kp N5  &kp N6  &kp DE_DOT    &mo LAYER_PROGRAMMING
  &kp LMETA              &kp ESC      &kp TAB         &kp LG(DE_V)    &kp RET          &kp LG(DE_Z)      &kp DE_COLON       &kp N1  &kp N2  &kp N3  &kp DE_COMMA  &kp RMETA
                                                      &none           &trans           &thm LCTRL TAB    &thm LALT RET      &kp N0  &none
)

/* ─── Layer 4 — Control (M3 + M4) ───────────────────────────────────────────
   F1    F2     F3     F4      F5      F6  │ F7    F8     F9      F10    F11   F12
   --   BT clr BT prev BT next Bri-    Bri+ │ Prev  Play   Studio  Next   Mute  --
  Cmd    --     --     --      --      --  │ Vol-  Vol+   --      --     --   Cmd
                         --  Shift  Ctrl  │ Alt   --     --
─────────────────────────────────────────────────────────────────────────── */
/* M3/M4 positions remain blocked. Modifiers are explicit for F-key shortcuts.
 * Releases of held layer keys use their original press bindings.
 * Brightness support depends on the Mac/display.
 */
ZMK_LAYER(control_layer,
  &kp F1     &kp F2      &kp F3      &kp F4      &kp F5        &kp F6          &kp F7        &kp F8        &kp F9          &kp F10     &kp F11     &kp F12
  &none      &bt BT_CLR  &bt BT_PRV  &bt BT_NXT  &kp C_BRI_DN  &kp C_BRI_UP    &kp C_PREV    &kp C_PP      &studio_unlock  &kp C_NEXT  &kp C_MUTE  &none
  &kp LMETA  &none       &none       &none       &none         &none           &kp C_VOL_DN  &kp C_VOL_UP  &none           &none       &none       &kp RMETA
                                     &none       &kp LSHIFT    &kp LCTRL       &kp LALT      &none         &none
)
